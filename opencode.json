{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-opencode", "opencode-openai-codex-auth"],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.4": {
          "name": "GPT-5.4",
          "limit": { "context": 1050000, "output": 128000 },
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      }
    },
    "github-copilot": {
      "models": {
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6 (Copilot)",
          "limit": { "context": 200000, "output": 32000 },
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Copilot)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Copilot)",
          "limit": { "context": 1000000, "output": 65536 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash (Copilot)",
          "limit": { "context": 1000000, "output": 65536 },
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "gpt-5.4": {
          "name": "GPT-5.4 (Copilot)",
          "limit": { "context": 1050000, "output": 128000 },
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "gpt-5-mini": {
          "name": "GPT-5 Mini (Copilot)",
          "limit": { "context": 128000, "output": 16384 },
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "grok-code-fast-1": {
          "name": "Grok Code Fast 1 (Copilot)",
          "limit": { "context": 131072, "output": 32768 },
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      }
    }
  }
}
